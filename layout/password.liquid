<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_accent }}">
  <meta name="robots" content="noindex">

  <title>{{ shop.name }} — {{ 'password.default_message' | t }}</title>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'kyn-logo.png' | asset_url }}">
  {%- endif -%}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    @font-face {
      font-family: 'Friendship';
      src: url('{{ 'Friendship-Medium.otf' | asset_url }}') format('opentype');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    :root {
      --periwinkle-500: {{ settings.color_accent }};
      --periwinkle-600: {{ settings.color_accent_hover }};
      --paper: {{ settings.color_page_bg }};
    }
    body {
      background: var(--periwinkle-200);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
    }
    .pw-card {
      background: var(--white);
      border-radius: var(--radius-xl);
      padding: 48px 40px 36px;
      max-width: 440px;
      width: 100%;
      text-align: center;
      box-shadow: var(--shadow-lg);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .pw-logo { height: 48px; width: auto; margin-bottom: 28px; }
    .pw-title {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: clamp(30px, 5vw, 44px);
      line-height: 1.05;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      margin: 0 0 14px;
      color: var(--ink-900);
    }
    .pw-lead { color: var(--ink-700); font-size: 16px; line-height: 1.6; max-width: 360px; margin: 0 0 28px; }
    .pw-lead p { margin: 0 0 8px; }
    .pw-form, .pw-newsletter { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 340px; margin: 0 auto 20px; }
    .pw-input {
      width: 100%;
      padding: 13px 16px;
      border: 1.5px solid var(--ink-100);
      border-radius: var(--radius-pill);
      font-family: inherit;
      font-size: 15px;
      background: var(--white);
      color: var(--ink-900);
    }
    .pw-input:focus { outline: 2px solid var(--periwinkle-700); outline-offset: 2px; border-color: var(--periwinkle-500); }
    .pw-btn {
      padding: 13px 24px;
      background: var(--periwinkle-700);
      color: #fff;
      border: none;
      border-radius: var(--radius-pill);
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }
    .pw-btn:hover { background: var(--periwinkle-800); }
    .pw-btn--secondary { background: var(--white); color: var(--periwinkle-800); border: 1.5px solid var(--periwinkle-300); }
    .pw-btn--secondary:hover { background: var(--periwinkle-50); }
    .pw-success { color: var(--periwinkle-800); font-weight: 600; font-size: 14px; margin: 4px 0 0; }
    .pw-error, .errors { color: #A23A3A; font-size: 14px; margin: 0; }
    .pw-social { display: flex; gap: 8px; justify-content: center; margin-top: 4px; }
    .pw-social a { width: 36px; height: 36px; border-radius: 50%; background: var(--periwinkle-50); color: var(--periwinkle-800); display: flex; align-items: center; justify-content: center; }
    .pw-footer { margin-top: 24px; color: var(--ink-500); font-size: 13px; }
  </style>
</head>

<body>
  {{ content_for_layout }}
</body>
</html>
