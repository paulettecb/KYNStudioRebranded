{%- capture menu_font -%}{% render 'font-stack', key: section.settings.menu_font %}{%- endcapture -%}
{%- capture cart_label_font -%}{% render 'font-stack', key: section.settings.cart_label_font %}{%- endcapture -%}

<header class="site-header" id="site-header-{{ section.id }}">
  <div class="site-header__row">
    <a href="{{ routes.root_url }}" class="site-header__brand" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_w = section.settings.logo_height | times: section.settings.logo.aspect_ratio | round -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag:
          class: 'site-header__logo',
          alt: shop.name,
          width: logo_w,
          height: section.settings.logo_height,
          loading: 'eager'
        }}
      {%- else -%}
        <img class="site-header__logo" src="{{ 'kyn-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="65" height="30">
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="{{ 'general.main_navigation' | t }}">
      <ul class="site-header__menu" id="site-header-menu">
        {%- for link in linklists[section.settings.menu].links -%}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__right">
      <button type="button" class="kyn-iconbtn kyn-iconbtn--sm site-header__burger" aria-expanded="false" aria-controls="site-header-menu" aria-label="{{ 'general.menu' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>
      <a class="kyn-iconbtn kyn-iconbtn--sm" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="kyn-iconbtn kyn-iconbtn--sm" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a class="kyn-btn kyn-btn--primary kyn-btn--sm site-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}, {{ 'cart.general.item_count' | t: count: cart.item_count }}">
        {% render 'icon', name: 'shopping-bag' %}
        <span class="site-header__cart-label" aria-hidden="true">{{ 'general.cart' | t }} ·</span>
        <span aria-hidden="true">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<style>
  #site-header-{{ section.id }} .site-header__menu{
    font-family: {{ menu_font }};
    font-size: {{ section.settings.menu_size }}px;
  }
  #site-header-{{ section.id }} .site-header__cart-label{
    font-family: {{ cart_label_font }};
    font-size: {{ section.settings.cart_label_size }}px;
  }
  #site-header-{{ section.id }} .site-header__logo{
    height: {{ section.settings.logo_height }}px;
    width: auto;
  }
</style>

<script>
(function () {
  var burger = document.querySelector('.site-header__burger');
  var menu = document.getElementById('site-header-menu');
  if (!burger || !menu) return;
  var BREAKPOINT = 1100;

  function closeMenu() {
    var wasOpen = menu.classList.contains('is-open');
    menu.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    if (wasOpen && menu.contains(document.activeElement)) burger.focus();
  }

  function toggleMenu() {
    var isOpen = menu.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    if (isOpen) {
      var firstLink = menu.querySelector('a');
      if (firstLink) firstLink.focus();
    }
  }

  burger.addEventListener('click', function (e) {
    e.stopPropagation();
    toggleMenu();
  });

  menu.addEventListener('click', function (e) {
    if (e.target.tagName === 'A') closeMenu();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeMenu();
  });

  document.addEventListener('click', function (e) {
    if (!menu.contains(e.target) && !burger.contains(e.target)) closeMenu();
  });

  window.addEventListener('resize', function () {
    if (window.innerWidth > BREAKPOINT) closeMenu();
  });
}());
</script>

{% schema %}
{
  "name": "Header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (leave blank to use bundled KYN logo)", "info": "Use a tightly cropped horizontal wordmark (transparent PNG or SVG)." },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 30 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },

    { "type": "header", "content": "Menu text" },
    { "type": "select", "id": "menu_font", "label": "Menu font", "default": "sans",
      "options": [
        { "value": "sans", "label": "Sans (Hanken Grotesk)" },
        { "value": "display", "label": "Display (Friendship script)" },
        { "value": "accent", "label": "Accent (Farmhouse serif)" }
      ] },
    { "type": "range", "id": "menu_size", "label": "Menu size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "Cart label" },
    { "type": "select", "id": "cart_label_font", "label": "Cart label font", "default": "sans",
      "options": [
        { "value": "sans", "label": "Sans (Hanken Grotesk)" },
        { "value": "display", "label": "Display (Friendship script)" },
        { "value": "accent", "label": "Accent (Farmhouse serif)" }
      ] },
    { "type": "range", "id": "cart_label_size", "label": "Cart label size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 }
  ]
}
{% endschema %}
