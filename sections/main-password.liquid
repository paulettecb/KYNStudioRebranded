{%- comment -%}
  KYN — Password page content (rendered inside layout/password.liquid)
{%- endcomment -%}

<div class="pw-card" id="main-password-{{ section.id }}">
  {%- if section.settings.logo != blank -%}
    {%- assign pw_logo_w = 48 | times: section.settings.logo.aspect_ratio | round -%}
    {{ section.settings.logo | image_url: width: 480 | image_tag: class: 'pw-logo', alt: shop.name, width: pw_logo_w, height: 48 }}
  {%- else -%}
    <img class="pw-logo" src="{{ 'kyn-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="120" height="55">
  {%- endif -%}

  <h1 class="pw-title">{{ section.settings.heading }}</h1>

  <div class="pw-lead">
    {%- if shop.password_message != blank -%}
      {{ shop.password_message }}
    {%- elsif section.settings.lead != blank -%}
      {{ section.settings.lead }}
    {%- else -%}
      {{ 'password.default_message' | t }}
    {%- endif -%}
  </div>

  {%- if section.settings.show_newsletter -%}
    {%- form 'customer', class: 'pw-newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <label class="visually-hidden" for="pw-email-{{ section.id }}">Email</label>
      <input id="pw-email-{{ section.id }}" type="email" name="contact[email]" class="pw-input" placeholder="{{ section.settings.newsletter_placeholder | escape }}" autocomplete="email" required>
      <button type="submit" class="pw-btn pw-btn--secondary">{{ section.settings.newsletter_button }}</button>
      {%- if form.posted_successfully? -%}
        <p class="pw-success">{{ section.settings.newsletter_success }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="pw-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
  {%- endif -%}

  {%- form 'storefront_password', class: 'pw-form' -%}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="password-{{ section.id }}">{{ 'password.label' | t }}</label>
    <input
      type="password"
      name="password"
      id="password-{{ section.id }}"
      class="pw-input"
      placeholder="{{ 'password.label' | t | escape }}"
      autocomplete="current-password"
    >
    <button type="submit" class="pw-btn">{{ 'password.submit' | t }}</button>
  {%- endform -%}

  <div class="pw-social">
    {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
    {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
  </div>

  <p class="pw-footer">{{ shop.name }}</p>
</div>

{% schema %}
{
  "name": "Password page",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pronto estamos aquí." },
    { "type": "richtext", "id": "lead", "label": "Text", "info": "Si escribes un mensaje en Shopify › Preferencias › Contraseña, ese mensaje tiene prioridad.", "default": "<p>Correas y collares hechos a mano en biothane original y latón sólido. Muy pronto en línea.</p>" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "newsletter_placeholder", "label": "Placeholder", "default": "Tu email para avisarte del lanzamiento" },
    { "type": "text", "id": "newsletter_button", "label": "Button", "default": "Avísenme" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "¡Listo! Te avisamos en cuanto abramos." }
  ]
}
{% endschema %}
