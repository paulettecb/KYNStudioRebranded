{%- comment -%}
  Renders a KYN option row for one product option.

  Color/finish-type options (name contains "color", "colour", "finish",
  "tono" or "acabado") render as round swatches with a mapped hex value
  (see snippets/color-hex.liquid). Any other option (e.g. a yes/no add-on
  like "Slider") renders as plain text pill buttons.

  Accepts:
    - option        {Object}  — product.options_with_values item
    - option_index  {Number}  — forloop.index0 (0-based)
    - section_id    {String}  — section.id, used to keep element ids unique

  Usage:
    {% render 'product-swatches', option: option, option_index: forloop.index0, section_id: section.id %}
{%- endcomment -%}

{%- assign option_name = option.name -%}
{%- assign option_val = option.selected_value -%}

{%- assign name_lc = option_name | downcase -%}
{%- assign is_color_option = false -%}
{%- if name_lc contains 'color' or name_lc contains 'colour' or name_lc contains 'finish' or name_lc contains 'tono' or name_lc contains 'acabado' -%}
  {%- assign is_color_option = true -%}
{%- endif -%}

{%- comment -%} Light swatches need a dark check mark {%- endcomment -%}
{%- assign light_hexes = '#c9b99a,#b8965a,#f4f0e8,#ffffff,#c9b8e8,#cccccc' | split: ',' -%}

<div class="kyn-option" data-option-index="{{ option_index }}">
  <div class="kyn-option__label" id="option-label-{{ section_id }}-{{ option_index }}">
    <span class="kyn-option__name">{{ option_name }}</span>
    <span class="kyn-option__value" id="option-value-{{ section_id }}-{{ option_index }}">{{ option_val }}</span>
  </div>

  <div class="{% if is_color_option %}kyn-swatches{% else %}kyn-pills{% endif %}" role="radiogroup" aria-labelledby="option-label-{{ section_id }}-{{ option_index }}">
    {%- for value in option.values -%}
      {%- assign is_selected = false -%}
      {%- if value == option_val -%}{%- assign is_selected = true -%}{%- endif -%}

      {%- if is_color_option -%}
        {%- capture hex -%}{% render 'color-hex', value: value %}{%- endcapture -%}
        {%- assign hex = hex | strip -%}
        {%- assign check_stroke = 'white' -%}
        {%- if light_hexes contains hex -%}
          {%- assign check_stroke = '#555' -%}
        {%- endif -%}

        <button
          type="button"
          role="radio"
          class="kyn-swatch{% if is_selected %} selected{% endif %}"
          style="background:{{ hex }};"
          data-option-index="{{ option_index }}"
          data-value="{{ value | escape }}"
          aria-label="{{ value | escape }}"
          aria-checked="{{ is_selected }}"
          title="{{ value | escape }}"
        >
          <span class="kyn-swatch__check" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none"
                 stroke="{{ check_stroke }}"
                 stroke-width="2.5"
                 stroke-linecap="round"
                 stroke-linejoin="round">
              <polyline points="2,6 5,9 10,3"/>
            </svg>
          </span>
        </button>

      {%- else -%}

        <button
          type="button"
          role="radio"
          class="kyn-swatch kyn-pill{% if is_selected %} selected{% endif %}"
          data-option-index="{{ option_index }}"
          data-value="{{ value | escape }}"
          aria-checked="{{ is_selected }}"
        >{{ value }}</button>

      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
